  <!-- ========================================================== -->
  <!-- Optical photon setup (top-level) -->
  <!-- ========================================================== -->

  <opticalsurfaces>
    <opticalsurface name="SiPMSurface"
                    model="unified"
                    type="dielectric_metal"
                    finish="polished">
      <property name="REFLECTIVITY" coldim="2"
                values="1.8*eV 0.05 3.5*eV 0.05"/>
      <property name="EFFICIENCY" coldim="2"
                values="1.8*eV 0.0 3.5*eV 0.0"/>
      <!-- Set to 0: detect all photons in SiPM volumes; apply QE/PDE in digitization -->
    </opticalsurface>

    <bordersurface name="Crystal_to_SiPM"
                   surface="SiPMSurface"
                   vol1="crystal_vol"
                   vol2="SiPM_bulk_vol"/>
  </opticalsurfaces>


  <!-- Physics extension for optical photons -->
  <extensions>
    <opticalphysics name="OpticalGammaPhys"/>
  </extensions>

  <!-- ========================================================== -->
  <!-- Readouts -->
  <!-- ========================================================== -->
  <readouts>
    <readout name="EcalEndcapNHits">
      <segmentation type="NoSegmentation" key="sector"/>
      <id>system:8,sector:4,row:8,column:8</id>
    </readout>

    <readout name="EcalEndcapNOpticalHits">
      <segmentation type="NoSegmentation" key="sector"/>
      <id>system:8,sector:4,row:8,column:8</id>
      <filter ref="opticalphotons"/>
    </readout>
  </readouts>

</lccdd>
