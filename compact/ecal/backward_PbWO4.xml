            PCB_sizey="EcalEndcapN_crystalmodule_crystal_width"
            PCB_thickness="EcalEndcapN_crystalmodule_PCB_thickness"
            material="SiliconDioxide"/>
        </disk_12surface>
      </placements>

    </detector>


  </detectors>

  <!-- ========================================================== -->
  <!-- PbWO4 (CRYTUR) optical material definition -->
  <!-- ========================================================== -->
  <material name="leadtungsten_optical">
    <!--
      Derived from BaseMaterialType::PWO in the C++ materials code.
      Base definition (Pb, W, O composition, 10 g/cm³ density) originates from getBaseMaterial() in Materials.cc.
      This XML extends it with Crytur-provided optical parameters (RINDEX, ABSLENGTH, and emission spectra).
      Note: density adjusted to realistic 8.28 g/cm³; base Geant4 material had no optical properties.
    -->
    <D type="density" value="8.28" unit="g/cm3"/>
    <composite n="1" ref="Pb"/>
    <composite n="1" ref="W"/>
    <composite n="4" ref="O"/>

    <!-- Refractive index (placeholder constant). Replace with your n(λ) if available. -->
    <property name="RINDEX" coldim="2" values="
          1.55*eV 2.28
          3.75758*eV 2.28
    "/>

