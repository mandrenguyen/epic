      sizey="EcalEndcapN_crystalmodule_sensor_sizeY"
      sizez="0.2*mm"
      z_offset="EcalEndcapN_crystalmodule_crystal_length/2 + 0.1*mm + EcalEndcapN_crystalmodule_VM2000_thickness"
      material="SiliconDioxide_optical"
      vis="CyanVis">
  </SiPM>

  <SiPM
      name="SiPM_bulk_vol"
      sizex="EcalEndcapN_crystalmodule_sensor_sizeX"
      sizey="EcalEndcapN_crystalmodule_sensor_sizeY"
      sizez="EcalEndcapN_crystalmodule_sensor_thickness - 0.2*mm"
      z_offset="EcalEndcapN_crystalmodule_crystal_length/2 + EcalEndcapN_crystalmodule_sensor_thickness/2 + EcalEndcapN_crystalmodule_VM2000_thickness"
      material="SiPM_optical"
      vis="YellowVis">
    <sensitive ref="EcalEndcapNOpticalHits"/>
  </SiPM>

  <wrapper
